@@ -0,0 +1,36 @@
+import type { Shard } from "../types/types";
+
+/**
+ * Cumulative number of Attribute Shards that must be syphoned to reach a given
+ * level (index 0 => level 1, index 9 => level 10 / max) for each rarity.
+ * Source: Hypixel Skyblock's attribute leveling table. Higher rarities need
+ * fewer shards to max.
+ */
+export const CUMULATIVE_SHARDS_BY_RARITY: Record<Shard["rarity"], number[]> = {
+  common: [1, 4, 9, 15, 22, 30, 40, 54, 72, 96],
+  uncommon: [1, 3, 6, 10, 15, 21, 28, 36, 48, 64],
+  rare: [1, 3, 6, 9, 13, 17, 22, 28, 36, 48],
+  epic: [1, 2, 4, 6, 9, 12, 16, 20, 25, 32],
+  legendary: [1, 2, 3, 5, 7, 9, 12, 15, 19, 24],
+};
+
+export const MAX_ATTRIBUTE_LEVEL = 10;
+
+/**
+ * Number of additional shards required to take an attribute of the given
+ * rarity from `currentLevel` (0 = not started) to max level (10).
+ * Returns 0 if already maxed.
+ */
+export function getShardsNeededToMax(rarity: Shard["rarity"], currentLevel: number): number {
+  const table = CUMULATIVE_SHARDS_BY_RARITY[rarity];
+  if (!table) return 0;
+
+  const maxCumulative = table[MAX_ATTRIBUTE_LEVEL - 1];
+  const clampedLevel = Math.max(0, Math.min(MAX_ATTRIBUTE_LEVEL, Math.floor(currentLevel)));
+
+  if (clampedLevel >= MAX_ATTRIBUTE_LEVEL) return 0;
+  if (clampedLevel <= 0) return maxCumulative;
+
+  const ownedCumulative = table[clampedLevel - 1];
+  return Math.max(0, maxCumulative - ownedCumulative);
+}
